# ===========================================
# 🚀 Bare Minimum Directus Environment
# ===========================================

# Core Server
HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

# Database (sqflite)
# DB_CLIENT=sqlite3
# DB_FILENAME=./db.db
# EXTENSIONS_PATH=./

# Database (Postgres)
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=

# Admin User (only used on first boot if no user exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=supersecret

# Secret (required for signing tokens etc)
SECRET=your_random_secret_key
